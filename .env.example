# Auth (better-auth)
BETTER_AUTH_SECRET=genera-un-secreto-seguro-de-al-menos-32-caracteres
# Local:
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# Producción (Vercel + lumixtv.stream):
# BETTER_AUTH_URL=https://lumixtv.stream
# NEXT_PUBLIC_BETTER_AUTH_URL=https://lumixtv.stream
# Acceso desde móvil/red local (IP de tu PC, separadas por coma):
# BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.1.5:3000

# Supabase PostgreSQL
# DATABASE_URL="postgresql://..."
# DIRECT_URL="postgresql://..."

# ─── Email sin dominio propio (desarrollo) ───
# Opción 1: Sin verificación — entra directo al registrarse
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Opción 2: Con verificación — usa sandbox de Resend (gratis)
# AUTH_REQUIRE_EMAIL_VERIFICATION=true
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL="LumixTV <onboarding@resend.dev>"
# (solo envía al correo con el que te registraste en resend.com)

# ─── Email con dominio propio (producción) ───
# AUTH_REQUIRE_EMAIL_VERIFICATION=true
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL="LumixTV <no-reply@lumixtv.stream>"
# RESEND_DOMAIN=lumixtv.stream

# Super admin (solo este correo puede promoverse con npm run admin:promote)
# SUPER_ADMIN_EMAIL=tu@correo.com

# TMDB (catálogo de películas y series)
# Regístrate gratis en https://www.themoviedb.org/settings/api
# TMDB_API_KEY=tu_api_key_v3

# Vimeus (reproducción y catálogo)
# Regístrate en https://vimeus.com/
# view_key → /settings/general (solo servidor, para embeds)
# API Key → dashboard (solo servidor, para listados)
# VIMEUS_VIEW_KEY=tu_view_key
# VIMEUS_API_KEY=tu_api_key
# VIMEUS_EMBED_BASE=https://vimeus.com

# En Vivo — catálogo público de canales IPTV (sin API key)
# Fuente En Vivo: IPTV Nexus API (https://dearbulut.github.io/iptv/api/v1/)
# channels.json + streams.json + logos.json + categories.json + countries.json
